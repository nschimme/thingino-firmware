#!/bin/sh
# shellcheck disable=SC1091,SC2034,SC2086,SC3043

if [ -r /etc/init.d/lib-log ]; then
	. /etc/init.d/lib-log
else
	log() { echo "$@"; }
fi

DAEMON="/usr/sbin/matterd"
DAEMON_NAME="matterd"
PIDFILE="/run/matterd.pid"

read_config() {
	jct /etc/thingino.json get "$1" 2>/dev/null
}

start_daemon() {
	mkdir -p /run/matter

	disc=$(read_config "matter.discriminator")
	pass=$(read_config "matter.passcode")
	port=$(read_config "matter.port")
	backend=$(read_config "matter.stream_backend")

	disc="${disc:-3840}"
	pass="${pass:-20202021}"
	port="${port:-5540}"
	backend="${backend:-auto}"

	# Detect active IPv6 link-local interface
	iface_idx=1
	for iface in eth0 wlan0 usb0; do
		if [ -d "/sys/class/net/$iface" ]; then
			idx=$(cat "/sys/class/net/$iface/ifindex" 2>/dev/null)
			if [ -n "$idx" ]; then
				iface_idx="$idx"
				break
			fi
		fi
	done

	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- \
		--interface "$iface_idx" \
		--discriminator "$disc" \
		--pin "$pass" \
		--port "$port" \
		--backend "$backend" \
		--credentials /etc/matter/credentials \
		--state /etc/matter/matter_state.bin
}

stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	pids=$(pidof "$DAEMON_NAME" 2>/dev/null)
	[ -n "$pids" ] && kill $pids 2>/dev/null
}

start() {
	log -c 15 "Starting Matter daemon"

	if [ "true" != "$(read_config "matter.enabled")" ]; then
		echo "Matter service disabled in config" >&2
		exit 1
	fi

	start_daemon
}

stop() {
	log -c 15 "Stopping Matter daemon"
	stop_daemon
	rm -rf /run/matter
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
