#!/bin/sh
# shellcheck disable=SC1091,SC2034,SC2086,SC3043
# matterctl - CLI for Thingino Matter 1.5 daemon

FIFO="/run/matter/cmd.fifo"

send_cmd() {
	cmd="$1"
	if [ ! -p "$FIFO" ]; then
		echo "matterd is not running or FIFO not available" >&2
		exit 1
	fi
	printf '%s\n' "$cmd" >"$FIFO"
}

get_config() {
	jct /etc/thingino.json get "$1" 2>/dev/null
}

case "$1" in
	status)
		if pidof matterd >/dev/null 2>&1; then
			echo "matterd is running (PID $(pidof matterd))"
			disc=$(get_config "matter.discriminator")
			pass=$(get_config "matter.passcode")
			echo "Discriminator: ${disc:-3840}"
			echo "Passcode: ${pass:-20202021}"
		else
			echo "matterd is stopped"
		fi
		;;
	announce)
		send_cmd "announce"
		echo "Announced Matter 1.5 discovery via mDNS"
		;;
	nightmode)
		if [ "$2" = "on" ] || [ "$2" = "off" ]; then
			send_cmd "nightmode $2"
		else
			echo "Usage: matterctl nightmode {on|off}"
			exit 1
		fi
		;;
	privacy)
		if [ "$2" = "on" ] || [ "$2" = "off" ]; then
			send_cmd "privacy $2"
		else
			echo "Usage: matterctl privacy {on|off}"
			exit 1
		fi
		;;
	pairing-code)
		if pidof matterd >/dev/null 2>&1; then
			code=$(matterctl status | sed -n 's/.*"pairing_code"[[:space:]]*:[[:space:]]*"\([0-9]*\)".*/\1/p')
			[ -n "$code" ] && {
				echo "$code"
				exit 0
			}
		fi
		disc=$(get_config "matter.discriminator")
		pass=$(get_config "matter.passcode")
		disc="${disc:-3840}"
		pass="${pass:-20202021}"
		disc_4bits=$(((disc >> 8) & 15))
		val1=$((((pass & 16383) << 5) | (disc_4bits << 1)))
		val2=$((pass >> 14))
		code10=$(printf "%05d%05d" "$val1" "$val2")
		# Compute Verhoeff check character
		c=0
		len=${#code10}
		pos=1
		while [ "$len" -gt 0 ]; do
			digit=$(printf '%s' "$code10" | cut -c "$len")
			p_idx=$((pos % 8))
			case "$p_idx" in
				0) p_val="$digit" ;;
				1) case "$digit" in 0) p_val=1 ;; 1) p_val=5 ;; 2) p_val=7 ;; 3) p_val=6 ;; 4) p_val=2 ;; 5) p_val=8 ;; 6) p_val=3 ;; 7) p_val=0 ;; 8) p_val=9 ;; 9) p_val=4 ;; esac ;;
				2) case "$digit" in 0) p_val=5 ;; 1) p_val=8 ;; 2) p_val=0 ;; 3) p_val=3 ;; 4) p_val=7 ;; 5) p_val=9 ;; 6) p_val=6 ;; 7) p_val=1 ;; 8) p_val=4 ;; 9) p_val=2 ;; esac ;;
				3) case "$digit" in 0) p_val=8 ;; 1) p_val=9 ;; 2) p_val=1 ;; 3) p_val=6 ;; 4) p_val=0 ;; 5) p_val=4 ;; 6) p_val=3 ;; 7) p_val=5 ;; 8) p_val=2 ;; 9) p_val=7 ;; esac ;;
				4) case "$digit" in 0) p_val=9 ;; 1) p_val=4 ;; 2) p_val=5 ;; 3) p_val=3 ;; 4) p_val=1 ;; 5) p_val=2 ;; 6) p_val=6 ;; 7) p_val=8 ;; 8) p_val=7 ;; 9) p_val=0 ;; esac ;;
				5) case "$digit" in 0) p_val=4 ;; 1) p_val=2 ;; 2) p_val=8 ;; 3) p_val=6 ;; 4) p_val=5 ;; 5) p_val=7 ;; 6) p_val=3 ;; 7) p_val=9 ;; 8) p_val=0 ;; 9) p_val=1 ;; esac ;;
				6) case "$digit" in 0) p_val=2 ;; 1) p_val=7 ;; 2) p_val=9 ;; 3) p_val=3 ;; 4) p_val=8 ;; 5) p_val=0 ;; 6) p_val=6 ;; 7) p_val=4 ;; 8) p_val=1 ;; 9) p_val=5 ;; esac ;;
				7) case "$digit" in 0) p_val=7 ;; 1) p_val=0 ;; 2) p_val=4 ;; 3) p_val=6 ;; 4) p_val=9 ;; 5) p_val=1 ;; 6) p_val=3 ;; 7) p_val=2 ;; 8) p_val=5 ;; 9) p_val=8 ;; esac ;;
			esac
			# Multiplication table d
			case "$c" in
				0) c="$p_val" ;;
				1) case "$p_val" in 0) c=1 ;; 1) c=2 ;; 2) c=3 ;; 3) c=4 ;; 4) c=0 ;; 5) c=6 ;; 6) c=7 ;; 7) c=8 ;; 8) c=9 ;; 9) c=5 ;; esac ;;
				2) case "$p_val" in 0) c=2 ;; 1) c=3 ;; 2) c=4 ;; 3) c=0 ;; 4) c=1 ;; 5) c=7 ;; 6) c=8 ;; 7) c=9 ;; 8) c=5 ;; 9) c=6 ;; esac ;;
				3) case "$p_val" in 0) c=3 ;; 1) c=4 ;; 2) c=0 ;; 3) c=1 ;; 4) c=2 ;; 5) c=8 ;; 6) c=9 ;; 7) c=5 ;; 8) c=6 ;; 9) c=7 ;; esac ;;
				4) case "$p_val" in 0) c=4 ;; 1) c=0 ;; 2) c=1 ;; 3) c=2 ;; 4) c=3 ;; 5) c=9 ;; 6) c=5 ;; 7) c=6 ;; 8) c=7 ;; 9) c=8 ;; esac ;;
				5) case "$p_val" in 0) c=5 ;; 1) c=9 ;; 2) c=8 ;; 3) c=7 ;; 4) c=6 ;; 5) c=0 ;; 6) c=4 ;; 7) c=3 ;; 8) c=2 ;; 9) c=1 ;; esac ;;
				6) case "$p_val" in 0) c=6 ;; 1) c=5 ;; 2) c=9 ;; 3) c=8 ;; 4) c=7 ;; 5) c=1 ;; 6) c=0 ;; 7) c=4 ;; 8) c=3 ;; 9) c=2 ;; esac ;;
				7) case "$p_val" in 0) c=7 ;; 1) c=6 ;; 2) c=5 ;; 3) c=9 ;; 4) c=8 ;; 5) c=2 ;; 6) c=1 ;; 7) c=0 ;; 8) c=4 ;; 9) c=3 ;; esac ;;
				8) case "$p_val" in 0) c=8 ;; 1) c=7 ;; 2) c=6 ;; 3) c=5 ;; 4) c=9 ;; 5) c=3 ;; 6) c=2 ;; 7) c=1 ;; 8) c=0 ;; 9) c=4 ;; esac ;;
				9) case "$p_val" in 0) c=9 ;; 1) c=8 ;; 2) c=7 ;; 3) c=6 ;; 4) c=5 ;; 5) c=4 ;; 6) c=3 ;; 7) c=2 ;; 8) c=1 ;; 9) c=0 ;; esac ;;
			esac
			len=$((len - 1))
			pos=$((pos + 1))
		done
		case "$c" in
			0) inv=0 ;; 1) inv=4 ;; 2) inv=3 ;; 3) inv=2 ;; 4) inv=1 ;;
			5) inv=5 ;; 6) inv=6 ;; 7) inv=7 ;; 8) inv=8 ;; 9) inv=9 ;;
		esac
		echo "${code10}${inv}"
		;;
	*)
		echo "Usage: $0 {status|announce|pairing-code|nightmode on|off|privacy on|off}"
		exit 1
		;;
esac

exit 0
